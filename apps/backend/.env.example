# Local backend configuration. Copy to apps/backend/.env and fill in private values there.
# Use localhost when the backend runs on your machine and PostgreSQL runs in Docker.
DATABASE_URL=postgresql+asyncpg://allocura:allocura@localhost:5432/allocura

# Azure Foundry embedding deployment.
EMBEDDING_PROVIDER=azure-openai
EMBEDDING_MODEL_NAME=text-embedding-3-large
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

# Azure Foundry extraction reuses the endpoint and key above.
LLM_PROVIDER=azure_openai
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
