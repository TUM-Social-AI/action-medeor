# Local backend configuration. Copy to apps/backend/.env and fill in private values there.
# Use localhost when the backend runs on your machine and PostgreSQL runs in Docker.
DATABASE_URL=postgresql+asyncpg://allocura:allocura@localhost:5432/allocura

# Azure Foundry embedding deployment.
EMBEDDING_PROVIDER=azure-openai
EMBEDDING_MODEL_NAME=text-embedding-3-large
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

# Azure Foundry extraction reuses the endpoint and key above.
LLM_PROVIDER=azure_openai
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna

# Read-only SharePoint folder sync (action-medeor tenant app registration).
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_FOLDER_ID=
SHAREPOINT_MEDICATION_FOLDER_ID=
SHAREPOINT_EQUIPMENT_FOLDER_ID=
# Domain folders must be direct children of the root. Medication may stay empty until uploaded.
# Scheduled extraction remains off; process-one is an explicit single-document override.
SHAREPOINT_PROCESSING_ENABLED=false
SHAREPOINT_MAX_DOCUMENTS_PER_RUN=1
SHAREPOINT_MAX_DOCUMENT_BYTES=20000000
SHAREPOINT_MAX_EXTRACTION_CHUNKS=32
SHAREPOINT_DOCUMENT_TIMEOUT_SECONDS=600
SHAREPOINT_MAX_ATTEMPTS=3
