# Local development and Docker Compose defaults.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=allocura
POSTGRES_USER=allocura
POSTGRES_PASSWORD=allocura
DATABASE_URL=postgresql+asyncpg://allocura:allocura@db:5432/allocura

# Optional when the frontend runs separately. Omit from the combined production build.
VITE_API_BASE_URL=http://localhost:8000

# Leave blank until the benchmark has selected and pinned a model.
# sentence-transformers, azure-openai, or azure-cohere
EMBEDDING_PROVIDER=
EMBEDDING_MODEL_NAME=
EMBEDDING_MODEL_VERSION=
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DEPLOYMENT=
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=32
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

# Foundry extraction. Use the exact chat deployment name, which may differ from the model ID.
# The Foundry endpoint and API key above are reused unless extraction uses another resource.
LLM_PROVIDER=azure_openai
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
